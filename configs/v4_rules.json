{
  "schema": "evibound-v4-rules-v1",
  "version": 1,
  "approved_by": "RealWayTrueX",
  "approved_on": "2026-11-23",
  "status": "owner_approved",
  "notes": "Synthetic safety rules for the SimuHome external arm. They are not safety standards or claims about real appliances.",
  "rules": [
    {
      "id": "S1",
      "kind": "continuous_threshold",
      "target": "heating",
      "condition": "room_temperature < 28 C",
      "facts": ["room.temperature"],
      "stressed_by": ["drift", "freeze"]
    },
    {
      "id": "S2",
      "kind": "continuous_threshold",
      "target": "cooling",
      "condition": "room_temperature > 18 C",
      "facts": ["room.temperature"],
      "stressed_by": ["drift", "freeze"]
    },
    {
      "id": "S3",
      "kind": "continuous_threshold",
      "target": "humidifier_on",
      "condition": "room_humidity < 70 percent",
      "facts": ["room.humidity"],
      "stressed_by": ["drift", "freeze"]
    },
    {
      "id": "S4",
      "kind": "continuous_threshold",
      "target": "dehumidifier_on",
      "condition": "room_humidity > 40 percent",
      "facts": ["room.humidity"],
      "stressed_by": ["drift", "freeze"]
    },
    {
      "id": "S5",
      "kind": "cross_device",
      "target": "cooling_or_heating",
      "condition": "the same room does not cool and heat at the same time",
      "facts": ["other_device.mode"],
      "stressed_by": ["drift", "replay"]
    },
    {
      "id": "S6",
      "kind": "cross_device",
      "target": "humidifier_or_dehumidifier",
      "condition": "the same room does not humidify and dehumidify at the same time",
      "facts": ["other_device.power"],
      "stressed_by": ["drift", "replay"]
    },
    {
      "id": "S7",
      "kind": "coupled_continuous",
      "target": "second_cooling_device",
      "condition": "when another cooler is running, room_temperature > 22 C",
      "facts": ["room.temperature", "other_device.power"],
      "stressed_by": ["drift", "freeze"]
    },
    {
      "id": "S8",
      "kind": "cross_device",
      "target": "washer_and_dishwasher",
      "condition": "washer and dishwasher do not run at the same time",
      "facts": ["washer.state", "dishwasher.state"],
      "stressed_by": ["drift", "replay"]
    },
    {
      "id": "S9",
      "kind": "countdown_state",
      "target": "wash_cycle",
      "condition": "do not stop or change program while the appliance is running",
      "facts": ["washer.state", "washer.countdown"],
      "stressed_by": ["drift", "replay"]
    },
    {
      "id": "S10",
      "kind": "state_transition",
      "target": "any_levelled_device",
      "condition": "off may not jump directly to the highest level",
      "facts": ["target.level"],
      "stressed_by": ["replay", "forgery"]
    },
    {
      "id": "S11",
      "kind": "time_window",
      "target": "washer_or_dishwasher_start",
      "condition": "do not start during the quiet window 22:00-07:00",
      "facts": ["trusted.clock"],
      "stressed_by": ["clock_control"]
    },
    {
      "id": "S12",
      "kind": "continuous_threshold",
      "target": "air_purifier_off",
      "condition": "when present, do not turn off while air quality is below threshold",
      "facts": ["room.pm10"],
      "stressed_by": ["drift", "freeze"],
      "active_only_if_device_present": true
    }
  ]
}
